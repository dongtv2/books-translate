# Copy this file to .env and fill in what you use. Never commit .env.
# AI providers can also be set up in the app (Cài đặt → AI); keys saved there
# are encrypted in the database.
# Get an API key at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Optional — defaults to claude-sonnet-5
ANTHROPIC_MODEL=claude-sonnet-5

# Optional — backend port (frontend dev server proxies /api to this port)
PORT=3001

# Optional — Metta-AI-Server (self-hosted NIM) address, if you run one.
# METTA_BASE_URL=http://<gpu-host>:8000/v1

# Optional — SSO (OIDC) form defaults; the rest is set in Settings.
# SSO_ISSUER=https://<sso-host>/realms/<realm>
# SSO_CLIENT_ID=books-translate
# SSO_PUBLIC_URL=https://<this-app-host>

# Optional — first run: a default administrator admin@localhost / admin is
# created (must change the password at first login). Set to 0 to use a
# one-time setup code instead.
# DEFAULT_ADMIN=0

# Optional — Kokoro TTS (đọc đoạn văn): Python venv with kokoro-onnx, and the
# model files. Read-aloud is off until all three are set.
# KOKORO_PYTHON=/path/to/venv/bin/python3
# KOKORO_MODEL_PATH=/path/to/kokoro-v1.0.onnx
# KOKORO_VOICES_PATH=/path/to/voices-v1.0.bin

# Optional — reverse proxy. By default X-Forwarded-* headers are trusted only
# from loopback / private addresses (Cloudflare Tunnel, nginx on the same host).
# Set to 0 when the server is exposed directly to the internet.
# TRUST_PROXY=0

# Optional — use a different SQLite file (staging, tests).
# BOOKS_DB_PATH=/path/to/books.db

# Optional — key that encrypts stored API keys / SSO secret (any long random
# string). Unset: a key is generated in server/data/secret.key. Keep a copy
# safe; without it, saved keys must be re-entered in Settings.
# SETTINGS_SECRET=…

# Optional — per-user limits per minute (0 = off). Defaults: assistant 30,
# translate 60, ai 30, tts 60, upload 20.
# RATE_ASSISTANT=…
# RATE_TRANSLATE=…
# RATE_AI=…
# RATE_TTS=…
# RATE_UPLOAD=…

# Optional — read-aloud: longest text per request, and audio cache size.
# TTS_MAX_CHARS=4000
# TTS_CACHE_MB=300

# Optional — kill switches (see docs/admin-roadmap.md)
# ACTIVITY_LOG=0
# BACKUP_AUTO=0
# BOOK_SCOPES=0
# VOCAB_PRIVATE=0
# VOCAB_SENSES=0
# TOC_STANDARD=0   (labels "Chương n" and front/back matter grouping off)

# Genres: set to 0 to turn off the AI genre suggestion on the book page
# GENRE_AI=1
