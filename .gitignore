# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Python venvs (e.g. server/riva/venv for nvidia-riva-client)
venv/
__pycache__/

# Backend secrets and local database — nothing under server/data is
# published (database, backups, covers, audio cache, credentials key)
.env
.env.*
!.env.example
server/data/*
!server/data/.gitkeep
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.pem
*.key
# local snapshots and per-machine assistant settings
.backup/
.claude/
server/data/*.db
server/data/*.db-journal
server/data/*.db-wal
server/data/*.db-shm
server/data/tts-cache/*.wav
# backups, cover images, the credentials key and one-time setup token
server/data/backups/
server/data/covers/
server/data/*.bak-*
server/data/secret.key
server/data/setup-token.txt

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
